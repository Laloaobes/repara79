APP_NAME=REPARA79
APP_ENV=production
APP_KEY=REPLACE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_RAILWAY_DOMAIN
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_RELEASE=railway

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=REPLACE_WITH_NEON_POOLED_CONNECTION_STRING
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
MAIL_MAILER=log
FILESYSTEM_DISK=public

ALLOW_PUBLIC_REGISTRATION=false
LOGIN_ATTEMPTS_PER_MINUTE=5
CORS_ALLOWED_ORIGINS=https://REPLACE_WITH_VERCEL_DOMAIN
CORS_ALLOWED_ORIGIN_PATTERNS=

# Railpack instala extensiones adicionales y ejecuta migraciones, seeders seguros,
# storage:link y optimizaciones durante el arranque de Laravel.
RAILPACK_PHP_EXTENSIONS=gd,pdo_pgsql
RAILPACK_SKIP_MIGRATIONS=false
