APP_NAME=REPARA79
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_RELEASE=local

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rpr-79
DB_USERNAME=postgres
DB_PASSWORD=
# Railway/Neon pueden usar DB_URL en lugar de los cinco campos anteriores.
# DB_URL=postgresql://usuario:password@host/base?sslmode=require
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SANCTUM_EXPIRATION=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Local permite registro. Railway debe usar false para el MVP restringido.
ALLOW_PUBLIC_REGISTRATION=true
LOGIN_ATTEMPTS_PER_MINUTE=5
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_PATTERNS=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
# Para una auditoría local puede usarse sync. En el servidor institucional se
# recomienda database y ejecutar php artisan queue:work.
QUEUE_CONNECTION=sync

# Reverb local. Sustituir ID, key y secret en cada entorno; no reutilizar los
# valores de ejemplo en producción.
REVERB_APP_ID=repara79-local
REVERB_APP_KEY=repara79-local-key
REVERB_APP_SECRET=change-this-local-secret
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
